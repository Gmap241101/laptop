-const parseTimeToMinutes = (timeString) => {
-  const [hours, minutes] = String(timeString || DEFAULT_WORK_END_TIME)
-    .split(':')
-    .map(Number);
-
-  if (
-    Number.isNaN(hours) ||
-    Number.isNaN(minutes) ||
-    hours < 0 ||
-    hours > 23 ||
-    minutes < 0 ||
-    minutes > 59
-  ) {
-    return 18 * 60;
-  }
-
-  return hours * 60 + minutes;
-};
