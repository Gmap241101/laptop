+
+export const useDashboardSummary = ({
+  firebaseAuthReady,
+  currentAuthRoleReady,
+  authenticatedAdminId,
+  currentAuthAdminAccountId,
+  view,
+  adminTab,
+  setAdminRequestTabCountsRemote,
+  triggerToast,
+}) => {
+  const [dashboardSummary, setDashboardSummary] = useState(null);
