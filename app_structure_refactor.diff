-
-    return {
-      date: holiday.date,
-      name: primaryReason.name,
-      type: primaryReason.type,
-      reasons: Object.fromEntries(
-        reasons.map((reason, index) => [
-          `reason${index + 1}`,
-          {
-            type: reason.type,
-            name: reason.name,
-          },
-        ])
-      ),
-      enabled: holiday.enabled !== false,
-    };
-  });
