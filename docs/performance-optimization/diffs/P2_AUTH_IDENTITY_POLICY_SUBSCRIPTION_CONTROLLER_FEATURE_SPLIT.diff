+      Boolean(authenticatedAdminId) &&
+      Boolean(currentAuthAdminAccount?.id);
+
+    const shouldLoadAdminAccounts =
+      hasAdminSession &&
+      view === 'admin' &&
+      adminTab === 'adminAccounts';
+
+    if (!shouldLoadAdminAccounts) {
