{
  "homepage": "https://Gmap241101.github.io/laptop",
  "name": "dept-laptop-rental",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prebuild": "npm run audit:react-hooks && npm run audit:app-flows && npm run audit:firestore:strict",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "analyze:source": "node tools/analyze-source-graph.mjs",
    "analyze:bundle": "npm run build && node tools/analyze-bundle.mjs",
    "analyze:bundle:baseline": "npm run build && node tools/analyze-bundle.mjs --save-baseline",
    "analyze:bundle:compare": "npm run build && node tools/analyze-bundle.mjs --baseline=docs/performance-optimization/measurements/BUNDLE_ANALYSIS_BASELINE.json",
    "audit:react-hooks": "node tools/audit-react-hooks.mjs",
    "audit:firestore": "node tools/audit-firestore-access.mjs",
    "audit:firestore:strict": "node tools/audit-firestore-access.mjs --strict",
    "verify:performance": "npm run audit:react-hooks && npm run audit:app-flows && npm run audit:firestore:strict && npm run analyze:source",
    "audit:app-flows": "node tools/audit-app-flow-contracts.mjs"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.1.0"
  }
}
